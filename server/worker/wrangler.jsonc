{
  "$schema": "https://developers.cloudflare.com/workers/wrangler-schema.json",
  "name": "tradeflow-polymarket-gateway",
  "main": "polymarket-gateway-worker.mjs",
  "compatibility_date": "2026-09-01",
  "placement": {
    "region": "aws:eu-west-1"
  },
  "routes": [
    {
      "pattern": "poly-api.pan911.cn",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
