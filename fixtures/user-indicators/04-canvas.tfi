defineIndicator({
  formatVersion: 1,
  apiVersion: 1,
  id: 'fixture.canvas',
  indicatorVersion: 1,
  name: 'Canvas Fixture',
  inputs: {},
  supports: { seriesKinds: ['ohlcv'] },
  create(context) {
    const canvas = context.layers.createCanvasLayer({ key: 'labels', target: { type: 'current-main-series' }, zOrder: 'top' });
    return { update(event) {
      const last = event.bars[event.bars.length - 1];
      if (!last) return canvas.setCommands([]);
      canvas.setCommands([
        { type: 'line', from: { space: 'time-price', time: last.time, price: last.low }, to: { space: 'time-price', time: last.time, price: last.high }, color: '#f6a623', lineWidth: 1 },
        { type: 'text', at: { space: 'time-price', time: last.time, price: last.high }, text: 'Last', color: '#f6a623', fontSize: 11, align: 'center' },
      ]);
    } };
  },
});
